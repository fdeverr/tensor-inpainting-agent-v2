# ============================================================
# Tensor Inpainting Agent Framework LLM 环境变量模板
#
# 使用方法：复制本文件为 .env，并填入真实值。
#   cp .env.example .env
# 注意：.env 已在 .gitignore 中排除，不会被提交到版本库。
#
# 这三个变量只在 llm_mode=auto 或 required 时才会被读取；
# llm_mode=off（确定性 fallback）时无需配置。
# 缺少任一项时：auto 会回退到确定性规则，required 会直接报错。
# ============================================================

# 模型 ID（模型服务上的具体模型名）
LLM_MODEL_ID=

# API 密钥
LLM_API_KEY=

# LLM 服务的 base URL（形如 https://api.example.com/v1）
LLM_BASE_URL=

# 可选：OpenAI 接口风格，取值为 chat 或 responses，默认 chat。
#   chat      -> /v1/chat/completions，兼容 DeepSeek、Qwen、Kimi、智谱、Ollama 等
#   responses -> /v1/responses，OpenAI 官方新接口，仅官方及少数厂商支持
# 对其他服务商（Anthropic / Gemini）无效。
LLM_API_STYLE=chat

# 可选：专用多模态模型 ID。留空时复用 LLM_MODEL_ID。
# 该模型需要支持 OpenAI 兼容的图像输入。
VISION_MODEL_ID=

# 可选：多模态模型使用不同服务时填写；留空时复用 LLM_API_KEY / LLM_BASE_URL。
VISION_API_KEY=
VISION_BASE_URL=

# 可选：多模态模型单独指定接口风格；留空时复用 LLM_API_STYLE。
VISION_API_STYLE=
